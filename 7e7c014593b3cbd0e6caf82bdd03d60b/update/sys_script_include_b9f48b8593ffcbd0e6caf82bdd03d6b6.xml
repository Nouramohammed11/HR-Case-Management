        <script><![CDATA[var HRCaseUserUtils = Class.create();
HRCaseUserUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
getUserDetails: function() {
var callerId = this.getParameter('sysparm_caller_id');
if (!callerId) {
return '';
}
var userGR = new GlideRecord('sys_user');
if (userGR.get(callerId)) {
return JSON.stringify({
department: userGR.getValue('department') || '',
email: userGR.getValue('email') || ''
});
}
return '';
},
type: 'HRCaseUserUtils'
});]]></script>
